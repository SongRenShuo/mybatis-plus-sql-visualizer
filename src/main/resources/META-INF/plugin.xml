    <!-- 插件变更说明由 build.gradle.kts patchPluginXml.changeNotes 注入（M18.2）——
         此处不写 change-notes：patchPluginXml 自动注入会覆盖显式值，且 changelog 插件从
         CHANGELOG.md [Unreleased] 自动提取会取错分区（多 ### Added），显式配置在构建脚本 -->
    <!-- 插件兼容性声明
         （M14.7 动态插件支持）：仅依赖 com.intellij.java（内置模块，常驻加载）；
         Kotlin 支持不静态引用 Kotlin PSI API，只在可选描述文件注册语言入口并读取通用 PsiFile 文本；
         Kotlin 插件不支持动态卸载，故依赖保持 optional，缺席时主插件仍可加载；
         kotlin-stdlib 由构建自动打包进插件 jar，功能不受影响 -->
    <depends>com.intellij.java</depends>
    <!-- T-M24-04 XML 预览：com.intellij.modules.xml（平台 bundled 模块，IDE 恒启用）——XML PSI 定位语句 + XML gutter 注册 -->
    <depends>com.intellij.modules.xml</depends>
    <!-- F-4：Kotlin Wrapper 链文本识别与主动入口降级说明；gutter 在不能可靠求表列时保持隐藏 -->
    <depends optional="true" config-file="kotlin-optional.xml">org.jetbrains.kotlin</depends>

    <!-- M17 执行 SQL：com.intellij.database（数据源/控制台，仅 Ultimate 捆绑）——
         官方规范（Plugin Dependencies）：可选依赖须声明 optional="true" + config-file，
         主描述文件不得直接引用可选插件类（本插件经反射隔离调用，Community 下优雅降级）；
         database-optional.xml 存放可选插件存在时才激活的声明（modelRelationProvider EP +
         T-CrudSql 数据库表右键 action——Community 下整文件不加载，实体类入口不受影响） -->
    <depends optional="true" config-file="database-optional.xml">com.intellij.database</depends>

    <!-- T-Dgm-01 JOIN 图原生渲染：com.intellij.diagram（Ultimate 捆绑 "Diagrams"，类图/关系图底座）——
         与 database 同为可选依赖；diagram-optional.xml 注册 diagram.Provider（SqlJoinDiagramProvider），
         Community / Diagrams 缺席时经 NativeJoinDiagramSupport 门面降级回自绘 DiagramPanel -->
    <depends optional="true" config-file="diagram-optional.xml">com.intellij.diagram</depends>

    <!-- T-McpToolset MCP 能力一期：com.intellij.mcpServer（平台内置 MCP Server 插件，253+/262 内置，
         243 不支持——旧 EP 形态适配成本>收益，见 CHANGELOG）——mcp-optional.xml 注册
         mcpServer.mcpToolset（十个只读工具，一工具一 toolset 类，清单见 mcp-optional.xml）。
         未装该插件的环境整文件不加载，
         插件其余功能零影响；编译期类型来自 mcpStub 桩源集（本机构建辅助，见 build.gradle.kts 注释） -->
    <depends optional="true" config-file="mcp-optional.xml">com.intellij.mcpServer</depends>

    <!-- T-AcpMcpTransport ACP 会话 MCP 工具下发修复：com.intellij.ml.llm（JetBrains AI Assistant，
         ACP agent 宿主，Marketplace 独立插件、非发行版捆绑）——acp-transport-optional.xml 注册
         com.intellij.ml.llm.agents.acp.ideaMcpTransportProvider，让 Claude Agent 会话以 SSE 形式
         拿到 IDE 私有 IJ MCP 会话，绕过上游 claude-agent-acp 对带 type 字段的 stdio server 的静默丢弃
         （根因与三条机会见 20260919-2130-T-AcpMcpTransport 开发计划 §1.3/§1.5）。
         未装该插件的环境整文件不加载，插件其余功能零影响；主文件不得直接引用 ml-llm 类型
         （与 database/mcp 可选依赖同款铁律，见 AcpTransportScopeSourceScanTest 守卫）；
         编译期类型来自 mcpStub 桩源集（见 build.gradle.kts 注释） -->
    <depends optional="true" config-file="acp-transport-optional.xml">com.intellij.ml.llm</depends>

    <!-- com.intellij 扩展点注册（M3 展示层 + M5 配置系统） -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- T-SettingsSearchA：插件设置项进入 IDE 自带设置搜索索引。
             平台索引有两个来源——插件 jar 内 search/searchableOptions.xml（构建期 fork IDE 生成，
             本仓 buildSearchableOptions=false 因 Windows 中文环境 locale 失败）与运行期
             search.optionContributor EP（SearchableOptionsRegistrarImpl.doInitialize 逐个调
             contribute）。走后者，不动构建。数据源与设置页内搜索同一份清单（ideSearchEntries）。
             门二（查询侧 instanceof SearchableConfigurable）由平台 ConfigurableWrapper 天然满足——
             它实现该接口且 getId() 返回 EP id，故各设置页无需改类。 -->
        <search.optionContributor implementation="cn.song.mybatisplus.visualizer.config.PluginSettingsSearchableOptionContributor"/>
        <!-- M56 T-M56-09：EP 双轨主通道——控制台行捕获（首行标志生效后桥轮询挂载停转） -->
        <consoleFilterProvider implementation="cn.song.mybatisplus.visualizer.log.SqlConsoleBridgeFilterProvider"/>
        <!-- T-M56Phase2-Premain：启动即捕获补位——Java 运行配置准备期向 VM 参数注入
             -javaagent:<agent jar 绝对路径>=port=<n>;logLevel=warn（EP 由 com.intellij.java 声明，
             :66 硬依赖已在位；注册形态与平台自家十余处 runConfigurationExtension 同形，无需 epName）。
             是否注入由 AgentManager 的「增强开关 + 注入确认」两道闸门决定：未开启/未确认零注入，
             注入链任何失败只记日志、回落 attach/桥，不影响用户 Run -->
        <runConfigurationExtension implementation="cn.song.mybatisplus.visualizer.log.agent.PremainRunConfigurationExtension"/>
        <!-- 全局配置（application-level，F-16）——@Service(Service.Level.APP) 注解式注册（M16.1 移除 XML
             双注册：官方规范禁止 plugin.xml 与 @Service 并存，双注册导致持久化绑定错实例、语言切换保存失效） -->

        <!-- SQL 预览服务（project-level，M16 起为轻服务：@Service(Service.Level.PROJECT) 注解声明，
             IDE 自动发现，无需 XML 注册；获取方式不变 project.getService(SqlPreviewService::class.java)） -->

        <!-- 设置页：Settings → Tools → SQL Visualizer
             （左侧树导航：父节点为文件夹，5 个子节点各自显示独立页面） -->
        <applicationConfigurable parentId="tools"
                                 id="cn.song.mybatisplus.visualizer.settings"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="configurable.settings.displayName"
                                 instance="cn.song.mybatisplus.visualizer.config.PluginSettingsFolderConfigurable"/>

        <!-- T-SettingsTruth P4：项目级设置页（project-level）——项目级 configurable 不得挂在
             应用级 configurable 之下（平台限制），挂 tools 顶层与全局页平级 -->
        <projectConfigurable parentId="tools"
                             id="cn.song.mybatisplus.visualizer.settings.project"
                             bundle="messages.MpSqlVisualizerBundle"
                             key="configurable.settings.project.displayName"
                             instance="cn.song.mybatisplus.visualizer.config.ProjectPluginSettingsConfigurable"/>

        <!-- 子页面顺序由 groupWeight 决定：平台 Weighted.COMPARATOR 按 weight 降序优先、displayName
             自然比较兜底；不设 weight 时 displayName 比较会随插件语言变化导致中英文子项顺序不一致
             （中文按码点序重排），故显式声明与声明序一致的递减 weight（ui=50 → about=10）。
             新增子页面时按区间插值取 weight，保持英文版既定顺序。 -->
        <!-- 界面与操作（gutter图标/语言；快捷键已独立为快捷键子页） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.ui"
                                 groupWeight="50"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.ui"
                                 instance="cn.song.mybatisplus.visualizer.config.UiActionsConfigurable"/>

        <!-- T-ShortcutSettings：快捷键统一管理（5 个动作快捷键内嵌录制编辑） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.shortcuts"
                                 groupWeight="45"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.shortcuts"
                                 instance="cn.song.mybatisplus.visualizer.config.ShortcutsConfigurable"/>

        <!-- SQL 预览（方言/参数替换/逻辑删除/多租户/数据权限/反向转换） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.preview"
                                 groupWeight="40"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.preview"
                                 instance="cn.song.mybatisplus.visualizer.config.SqlPreviewConfigurable"/>

        <!-- 表名映射（前缀/后缀/移除/忽略字段/推断策略） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.tableMapping"
                                 groupWeight="30"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.tableMapping"
                                 instance="cn.song.mybatisplus.visualizer.config.TableMappingConfigurable"/>

        <!-- SQL 日志（前缀/自动捕获/时间戳/格式化/过滤/去重/最大条数/耗时/慢查询/Hibernate/Jdbc/自动保存） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.sqlLog"
                                 groupWeight="20"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.sqlLog"
                                 instance="cn.song.mybatisplus.visualizer.config.SqlLogConfigurable"/>

        <!-- T-ShortcutSettings：MCP 工具；T-McpToolset2/T-MTS2-00 增补门控区（总开关+工具级启用禁用，McpToolGate） -->
        <applicationConfigurable parentId="cn.song.mybatisplus.visualizer.settings"
                                 id="cn.song.mybatisplus.visualizer.settings.mcp"
                                 groupWeight="15"
                                 bundle="messages.MpSqlVisualizerBundle"
                                 key="settings.section.mcp"
                                 instance="cn.song.mybatisplus.visualizer.config.McpConfigurable"/>

