                 原 Ctrl+Alt+S 与 IDE 打开 Settings 冲突、Ctrl+Alt+Q 为用户自选前的过渡默认；
                 Windows/Linux 与 macOS 各注册一份，可在 Keymap 或插件设置页修改 -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift Q"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt shift Q"/>
        </action>

        <!-- P0 SQL 反向转换：选中 SQL → MyBatis-Plus QueryWrapper Java 代码（右键菜单 + Alt+Shift+J；
             与 ConvertToSql 正向转换互补；不依赖 PSI，任何文件类型选择区可用） -->
        <action id="cn.song.mybatisplus.visualizer.ConvertSqlToJava"
                class="cn.song.mybatisplus.visualizer.actions.ConvertSqlToJavaAction"
                text="action.cn.song.mybatisplus.visualizer.ConvertSqlToJava.text"
                description="action.cn.song.mybatisplus.visualizer.ConvertSqlToJava.description"
                icon="/icons/sqlGutter.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift J"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift J"/>
        </action>

        <!-- T-CrudSql：实体类右键生成 CRUD SQL（编辑器 + 项目视图；update 判定 MP 实体注解；
             展示复用现有 SqlSelectionDialog + SqlPreviewService.showResult，零新弹窗；
             数据库表节点入口在 database-optional.xml——com.intellij.database 在场时才加载） -->
        <action id="cn.song.mybatisplus.visualizer.GenerateCrudSqlFromEntity"
                class="cn.song.mybatisplus.visualizer.actions.GenerateCrudSqlFromEntityAction"
                text="action.cn.song.mybatisplus.visualizer.GenerateCrudSqlFromEntity.text"
                description="action.cn.song.mybatisplus.visualizer.GenerateCrudSqlFromEntity.description"
                icon="/icons/sqlGutter.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- T-PreviewUx-Pack #3：${table} 快捷模板三动作（选中表名一键 EXPLAIN / COUNT / 抽样 10 行；
             三动作共享一个 group 注册 EditorPopupMenu，与「生成 CRUD SQL」入口并存不合并菜单；
             执行走既有内嵌控制台链路（DataSourceSelector + SqlExecutor），凭证不出 IDE；
             T-TemplateKeyDrop：三动作不设默认键位——原 Alt+Shift+E/C/T 与平台动作冲突
             （RecentChanges / tasks.switch），而备选键 Ctrl+Alt+Shift+同字母同样被占（Copy Reference /
             Refactor This），「冲突自动换绑」无解（实测见开发计划 §一）；改为由用户在设置页
             「快捷键」节或 IDE 的 Settings > Keymap 自行录制，右键菜单入口不受影响） -->
        <!-- 组文案由 class 提供（2026-09-23 真机走查修复）：<group> 的 text 属性不走 bundle 解析——
             只写 text= 或再补 bundle= 都会在右键菜单里显示原始键（实测；同文件 <action> 的 text+bundle
             正常）。平台对本地化组的正规做法是给 class，见 SqlTemplateGroup KDoc。 -->
        <group id="cn.song.mybatisplus.visualizer.SqlTemplateGroup"
               class="cn.song.mybatisplus.visualizer.actions.SqlTemplateGroup"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="cn.song.mybatisplus.visualizer.ExplainSelectedTable"
                    class="cn.song.mybatisplus.visualizer.actions.ExplainSelectedTableAction"
                    text="action.cn.song.mybatisplus.visualizer.ExplainSelectedTable.text"
                    description="action.cn.song.mybatisplus.visualizer.ExplainSelectedTable.description"
                    icon="/icons/sqlGutter.svg">
            </action>
            <action id="cn.song.mybatisplus.visualizer.CountSelectedTable"
                    class="cn.song.mybatisplus.visualizer.actions.CountSelectedTableAction"
                    text="action.cn.song.mybatisplus.visualizer.CountSelectedTable.text"
                    description="action.cn.song.mybatisplus.visualizer.CountSelectedTable.description"
                    icon="/icons/sqlGutter.svg">
            </action>
            <action id="cn.song.mybatisplus.visualizer.SampleSelectedTable"
                    class="cn.song.mybatisplus.visualizer.actions.SampleSelectedTableAction"
                    text="action.cn.song.mybatisplus.visualizer.SampleSelectedTable.text"
                    description="action.cn.song.mybatisplus.visualizer.SampleSelectedTable.description"
                    icon="/icons/sqlGutter.svg">
            </action>
        </group>

        <!-- UI015：自建预览保留基础编辑菜单，仅追加既有模板组，不引入主文件编辑器的全部动作。 -->
        <group id="cn.song.mybatisplus.visualizer.PreviewEditorPopupMenu">
            <reference ref="BasicEditorPopupMenu"/>
            <separator/>
            <reference ref="cn.song.mybatisplus.visualizer.SqlTemplateGroup"/>
        </group>

        <!-- T-ErrReport：帮助菜单反馈入口（手动形态报告对话框，提交直达官网需求池；
             对话框底部提供带 source/ideVersion/pluginVersion 参数的浏览器兜底链接） -->
        <action id="cn.song.mybatisplus.visualizer.Feedback"
                class="cn.song.mybatisplus.visualizer.feedback.FeedbackAction"
                text="action.cn.song.mybatisplus.visualizer.Feedback.text"
                description="action.cn.song.mybatisplus.visualizer.Feedback.description">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
