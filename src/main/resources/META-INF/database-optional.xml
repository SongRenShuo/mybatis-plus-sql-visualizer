<!--
  M17 执行 SQL：可选依赖描述文件（官方规范：<depends optional="true" config-file="...">）。

  本文件仅在 com.intellij.database 插件存在（IntelliJ IDEA Ultimate / DataGrip）时加载。
  声明在本文件的扩展引用的类只会在 DatabaseTools 存在时被实例化——Community 优雅降级。
-->
<idea-plugin>
    <!-- T-Embed-04：JOIN 虚拟外键——把 SQL JOIN 的 ON 等值条件以原生虚拟外键画入
         Database「显示图」（DbDiagramDataModel 建边时经 ModelRelationManager 聚合本 Provider）。
         EP 名 com.intellij.database.modelRelationProvider（ModelRelationManager 字节码实证）；
         数据来自 JoinFkRegistry 进程内存（换图即清，不写持久化配置）。 -->
    <extensions defaultExtensionNs="com.intellij.database">
        <modelRelationProvider implementation="cn.song.mybatisplus.visualizer.ui.diagram.nativefw.db.JoinVirtualFkProvider"/>
    </extensions>

    <!-- T-DmDialect（O-136 真机发现，20261014）：注册达梦 SQL 方言。放本文件（而非主 plugin.xml）
         的原因：实现类直引 DatabaseTools 的 SqlLanguageDialectBase——裸 test 桶/Community 下
         DatabaseTools 缺席时该类无法装载（20261014 实测 NoClassDefFoundError）；本文件仅在
         com.intellij.database 在场时加载，注册随插件存在性启停。262 平台方言注册表
         （database-plugin 35 项）实测无 DM → 语言 id `DM` 注册后即进入
         SqlDialectMappings.getAvailableValues，UrlSubprotocolDialects 的达梦候选链（[DM, Dameng]）
         随之命中，O-136 的「按数据源方言出 Runner」对达梦闭合。最小实现=Generic 样板
         （javap：TokensHelper 委托 Sql92、Dbms.UNKNOWN、不开错误高亮）。 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- dbms 是平台 Dbms 枚举名，不是语言 ID。243/253/262 均无 DM 枚举；
             与 Sql92/Generic 一样注册 UNKNOWN，保留语言 ID=DM，只提供 Generic 兼容能力。 -->
        <sql.dialect dbms="UNKNOWN" order="last"
                     implementationClass="cn.song.mybatisplus.visualizer.sql.dm.DmSqlDialect"/>
        <!-- T-GaussDbDialect（券 06）：同一缺口的第二个实例——262 平台方言注册表无 GaussDB 也无
             openGauss（.intellijPlatform 制品目录 grep gauss 零命中）。注册后语言 id `GaussDB`
             进入 SqlDialectMappings.getAvailableValues，ExecDialectRouting 的 GaussDB 候选链首项
             即命中，不再只能落 PostgreSQL 兜底。最小实现同样是 Generic 样板。 -->
        <sql.dialect dbms="UNKNOWN" order="last"
                     implementationClass="cn.song.mybatisplus.visualizer.sql.gaussdb.GaussDbSqlDialect"/>
        <!-- T-XcDialects3（券 08）：同一缺口的第三、四个实例——262 平台方言注册表无 HighGo 也无
             Vastbase（intellij.database.dialects.* 模块逐包列举实证，2026-10-29）。注册后语言
             id `HighGo`/`Vastbase` 进入平台可用清单，两族候选链首项即命中，不再只能落
             PostgreSQL 兜底。最小实现同样是 Generic 样板。 -->
        <sql.dialect dbms="UNKNOWN" order="last"
                     implementationClass="cn.song.mybatisplus.visualizer.sql.highgo.HighGoSqlDialect"/>
        <sql.dialect dbms="UNKNOWN" order="last"
                     implementationClass="cn.song.mybatisplus.visualizer.sql.vastbase.VastbaseSqlDialect"/>

        <!-- T-PreviewPsiDialect：上面四个自注册方言的 ParserDefinition——**必须成对存在**。

             缺了这一半会怎样（262 真机实证，2026-10-30）：平台 SqlParserDefinitionBase.createFile
             里有 `(SqlLanguageDialect) getFileNodeType().getLanguage()` 的强转；没有本方言的
             parserDefinition 时，平台沿语言链回落到基语言 SQL 的那份（其 file node type 绑的是
             基类 SqlLanguage）→ ClassCastException → PSI 建不出来 → PsiManager.findFile 返回 null
             → 预览预热降级成内存 PSI（表/列补全不可用），且 idea.log 里每次预览一条点名本插件的
             SEVERE。平台内置方言 SQL / GenericSQL / SQL92 全是成对注册的，见
             database-plugin.jar 的 plugin.xml:1253 / 1913 / 1925。

             守卫：SqlDialectParserDefinitionPairingGuardTest 静态校验「每个 sql.dialect 必须有
             同名 lang.parserDefinition」，加第五个方言时会先红。 -->
        <lang.parserDefinition language="DM"
                               implementationClass="cn.song.mybatisplus.visualizer.sql.DmParserDefinition"/>
        <lang.parserDefinition language="GaussDB"
                               implementationClass="cn.song.mybatisplus.visualizer.sql.GaussDbParserDefinition"/>
        <lang.parserDefinition language="HighGo"
                               implementationClass="cn.song.mybatisplus.visualizer.sql.HighGoParserDefinition"/>
        <lang.parserDefinition language="Vastbase"
                               implementationClass="cn.song.mybatisplus.visualizer.sql.VastbaseParserDefinition"/>
    </extensions>

    <!-- T-CrudSql：数据库表节点右键生成 CRUD SQL——add-to-group DatabaseViewPopupMenu
         （DatabaseTools 内部组，2024.3.7.1 plugin.xml:713 实证，无专门视图 action EP）；
         本文件仅 com.intellij.database 在场时加载，DbTable/DasTable 类引用全部直引编译期类型。
         update 判定 PSI_ELEMENT_ARRAY 含 DbTable，多选表合并展示。 -->
    <actions>
        <action id="cn.song.mybatisplus.visualizer.GenerateCrudSqlFromDbTable"
                class="cn.song.mybatisplus.visualizer.actions.GenerateCrudSqlFromDbTableAction"
                text="action.cn.song.mybatisplus.visualizer.GenerateCrudSqlFromDbTable.text"
                description="action.cn.song.mybatisplus.visualizer.GenerateCrudSqlFromDbTable.description"
                icon="/icons/sqlGutter.svg">
            <add-to-group group-id="DatabaseViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
