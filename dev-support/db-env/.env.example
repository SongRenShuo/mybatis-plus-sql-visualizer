# dev-support/db-env/.env —— 测试服务器数据库容器口令（示例模板）
#
# ⚠️ 本文件是模板：所有值都是 CHANGE_ME 占位，**不要在这里填真实口令**。
# 真实口令只有两个合法落点：
#   1. 本机 `.local/db-env.env`（整目录 gitignored，不进仓）
#   2. 服务器 `/root/db-env.env`（600，重放时 `--env-file` 指向它）
# 用法：
#   cp .env.example .env && vi .env            # 本地临时填
#   docker compose --env-file /root/db-env.env up -d   # 服务器上用外部文件
#
# 口令值必须与旧台账一致（用户 2026-11-12 要求「数据库账户密码不要变」），
# 台账唯一来源：.local/test-databases.md；服务器侧同值落在 /etc/svbackup/db.env。
# 两个 compose 变量与 db.env 变量的对应关系见 README「变量映射」表。

# MariaDB（业务用户 xc3 / root）
MARIADB_ROOT_PASS=CHANGE_ME
MARIADB_XC3_PASS=CHANGE_ME

# MySQL 8（root，mpj_demo 库）
MYSQL8_ROOT_PASS=CHANGE_ME

# SQL Server（sa）
MSSQL_SA_PASS=CHANGE_ME

# HighGo（initdb 超管 highgo；业务用户 xc3 的口令不在 compose 里，见 README 后置步骤）
HIGHGO_SUPER_PASS=CHANGE_ME

# Vastbase A/B（超管 omm 与业务用户 xc3 同口令）
VASTBASE_PASS=CHANGE_ME

# openGauss（初始超管 opengauss 与业务用户 xc3 同口令）
OPENGAUSS_PASS=CHANGE_ME

# OceanBase（sys 租户 / test 租户）
OCEANBASE_SYS_PASS=CHANGE_ME
OCEANBASE_TENANT_PASS=CHANGE_ME

# Oracle Free（APP_USER probe 的口令；ORACLE_PASSWORD 同值——本实例所有口令一致）
ORACLE_PROBE_PASS=CHANGE_ME

# 备注：TiDB 未出现在本文件——它由镜像 entrypoint 起空实例，root 口令在起容器后
# 用 `ALTER USER 'root'@'%' IDENTIFIED BY '<口令>'` 设置（见 README 后置步骤）。
# 磐维 pwadmin 口令也是首装后由 run.sh / ALTER USER 落地，不进 compose。