<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.UserMapper">

    <!--
      复现点（D254）：
      - resultMap 的 column / property 补全候选里不应出现静态字段（serialVersionUID、TABLE_NAME、LOG_TAG、VERSION_TAG）
      - 该 resultMap 只映射子类语义（created_at → createTime）
    -->
    <resultMap id="BaseResultMap" type="com.example.demo.entity.UserEntity">
        <id column="id" property="id"/>
        <result column="created_at" property="createTime"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
    </resultMap>

    <!-- foreach 的 item 属性补全：光标放进 #{item.|} 处，候选不应含静态字段 -->
    <select id="queryByXml" resultMap="BaseResultMap">
        SELECT id, created_at, username, nickname, version, deleted
        FROM t_user
        <where>
            <foreach collection="list" item="item" separator=" OR ">
                username = #{item.username}
            </foreach>
        </where>
    </select>
</mapper>
